# Browser configuration. Firebase web API keys identify a project; rules protect its data.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Absolute public URL, no trailing slash. Use http://localhost:3000 locally.
APP_URL=http://localhost:3000

# Server only. Never prefix these with NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Shared across the whole deployment, UTC days. Tune to your actual provider limits.
AI_DAILY_REQUEST_BUDGET=80
AI_DAILY_TOKEN_BUDGET=150000
AI_MIN_INTERVAL_MS=8000
# Real connections require explicit operator enablement after reviewing provider data controls.
MAIL_PROCESSING_ENABLED=false
